// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  expense       // קבלות החזר מס – קבלות שהוצאתי על הוצאות (להחזר מס)
  income       // חשבוניות – חשבוניות שהוצאתי ללקוחות
  payment_receipt  // קבלות על תשלום – קבלות שהוצאתי ללקוחות (הוכחת תשלום)
}

enum BusinessType {
  exempt    // עוסק פטור
  licensed  // עוסק מורשה
  company   // חברה בע"מ
}

model User {
  id    String @id @default(uuid())
  email String @unique

  // Business Profile
  businessType    BusinessType @default(exempt)
  businessName    String?
  taxId           String?      // ח.פ / ת.ז עסק
  vatPercent      Decimal      @default(18.0) @db.Decimal(4, 2)

  categories Category[]
  documents  Document[]
  transactions Transaction[]
  expenseFolders ExpenseFolder[]
  budgets    Budget[]
  financialProfile FinancialProfile?
  contracts  Contract[]
  passkeys   PasskeyCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BudgetScope {
  personal
  business
}

model Category {
  id     String @id @default(uuid())
  userId String
  name   String
  budgetScope BudgetScope?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model ExpenseFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String   @default("📁")
  sortOrder Int      @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Document {
  id        String       @id @default(uuid())
  userId    String
  type      DocumentType
  date      DateTime     @db.Date

  // Accounting fields
  amount        Decimal      @db.Decimal(12, 2) // Total
  vatAmount     Decimal      @default(0) @db.Decimal(12, 2)
  preVatAmount  Decimal      @default(0) @db.Decimal(12, 2)
  isRecognized  Decimal      @default(100.0) @db.Decimal(5, 2) // % recognized

  currency  String       @default("ILS")
  vendor    String
  categoryId String?
  expenseFolderId String?
  description String?
  docNumber  String?

  fileKey   String
  fileName  String
  fileMime  String
  fileSize  Int
  sha256    String?

  sourceUrl   String?  @db.Text // original receipt link (for link-only receipts)
  needsReview Boolean  @default(false) // auto-imported, waiting for user approval

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenseFolder ExpenseFolder? @relation(fields: [expenseFolderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, sha256])
  @@index([userId, expenseFolderId])
  @@index([userId, type, needsReview])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("ILS")
  vendor      String
  description String?
  categoryId  String?
  cardLast4   String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, updatedAt])
}

model PasskeyCredential {
  id     String @id @default(uuid())
  userId String

  // WebAuthn credential (stored as raw bytes)
  credentialId Bytes @unique
  publicKey    Bytes
  counter      Int   @default(0)
  transports   String?
  deviceName   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Budget {
  id            String   @id @default(uuid())
  userId        String
  month         String // YYYY-MM
  expenseLimit  Decimal  @db.Decimal(12, 2)
  manualIncome  Decimal? @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

// Wizard settings persisted per user (not per month)
model FinancialProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  goal                     String?  // emergency_fund | pay_debt | vacation | financial_independence | business_investment
  businessRetentionPercent Decimal? @db.Decimal(5, 2)
  checkingBalance          Decimal? @db.Decimal(14, 2) // עו"ש + פיקדונות נזילים
  monthlySavings           Decimal? @db.Decimal(12, 2)
  wizardCompletedAt        DateTime?
  personalCategories       Json?
  businessCategories       Json?
  wizardState              Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id                String    @id @default(uuid())
  userId            String
  clientName        String
  clientEmail       String?
  contractDate      DateTime?
  details           String?   @db.Text
  fileKey           String
  fileName          String
  fileMime          String
  fileSize          Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, contractDate])
}
