# Copy to .env and fill in real values. Never commit .env or .env.local.

# --- Database (PostgreSQL / Supabase) ---
# IMPORTANT for Vercel (serverless): DATABASE_URL must use Supabase connection POOLER (port 6543, pgbouncer=true)
# This avoids a new SSL TCP connection on every request (~300-500ms overhead on port 5432).
# In Supabase: Project → Settings → Database → Connection pooling → Transaction mode → copy URI and set port=6543
DATABASE_URL="postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL is for Prisma migrations only — keep on port 5432 (direct connection)
DIRECT_URL="postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth & sessions ---
AUTH_SECRET="YOUR_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"

# --- Encrypted password vault (AES key, hex or base64 as implemented) ---
CREDENTIALS_ENCRYPTION_KEY="YOUR_32_BYTE_KEY_HEX_OR_AS_PROVIDED"

# --- Cloudflare R2 (S3-compatible storage for document files) ---
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET="YOUR_BUCKET_NAME"

# --- Cron jobs (protect /api/cron/* and /api/cron/backup) ---
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"

# --- Twilio (WhatsApp incoming webhook) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"

# --- Email (password reset) — Resend ---
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
# RESEND_FROM="Finance OCR <noreply@yourdomain.com>"

# --- Public app URL (for reset-password links + Morning webhook display) ---
# NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# --- Gmail OAuth (expense receipts from email) — Google Cloud Console, free tier ---
# GOOGLE_GMAIL_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_GMAIL_CLIENT_SECRET="GOCSPX-..."
# Optional override: GOOGLE_GMAIL_REDIRECT_URI="https://your-domain.com/api/auth/gmail/callback"
# Uses CREDENTIALS_ENCRYPTION_KEY (or GMAIL_TOKEN_ENCRYPTION_KEY) to encrypt refresh tokens at rest

# --- Gemini AI (smart receipt detection + extraction) — Google AI Studio, free tier ---
# Get a free key at https://aistudio.google.com/apikey (no billing required)
# Without it the system falls back to keyword-based detection (still works, less accurate)
# GEMINI_API_KEY="AIza..."
# Optional model override (default gemini-flash-latest): GEMINI_MODEL="gemini-flash-latest"

# --- Optional: WebAuthn / Passkeys display name ---
# PASSKEY_RP_NAME="Finance OCR"

# The following are usually set automatically by Vercel — do not set locally unless needed:
# VERCEL="1"
# VERCEL_URL="..."
# NODE_ENV="development"
